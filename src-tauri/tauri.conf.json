{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kuro Launcher",
  "mainBinaryName": "kuro-launcher",
  "version": "0.2.2",
  "identifier": "com.wassuplol.kuro",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "KURO",
        "width": 1180,
        "height": 760,
        "minWidth": 520,
        "minHeight": 360,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0B0D12",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://*.rbxcdn.com https://*.roblox.com; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
